<Window x:Class="DeployToSolution.AddRowsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm dòng" Height="660" Width="840"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Chrome}" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== chọn loại, và bảng nếu loại đó thuộc phạm vi một bảng ===== -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                Padding="10,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Type" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="TypeCombo" Width="210" IsEditable="True"
                              TextBoxBase.TextChanged="Scope_TextChanged" />

                    <TextBlock x:Name="TableLabel" Text="của bảng" VerticalAlignment="Center" Margin="18,0,8,0" />
                    <ComboBox x:Name="TableCombo" Width="280" IsEditable="True" IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True" MaxDropDownHeight="320"
                              TextBoxBase.TextChanged="Scope_TextChanged" />

                    <CheckBox x:Name="IncludeAllBox" Content="IncludeAll" VerticalAlignment="Center" Margin="18,0,0,0"
                              ToolTip="Chỉ có nghĩa với Table: add kèm toàn bộ column / form / view / relationship của bảng." />
                </StackPanel>

                <TextBlock x:Name="Hint" Foreground="#605E5C" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- ===== lọc danh sách gợi ý ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,6">
            <TextBlock Text="Lọc" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="FilterBox" Width="320" Padding="4,3" TextChanged="FilterBox_TextChanged"
                     ToolTip="Gõ một phần tên, ví dụ Hs.Vus.Warehouse để lọc hết step của assembly đó." />
            <Button Content="Chọn hết đang hiện" Style="{StaticResource Flat}" MinWidth="130"
                    Margin="8,0,6,0" Click="CheckShown_Click" />
            <Button Content="Bỏ chọn hết" Style="{StaticResource Flat}" MinWidth="96" Click="UncheckAll_Click" />
            <TextBlock x:Name="ListInfo" VerticalAlignment="Center" Foreground="#605E5C" Margin="8,0,0,0" />
        </StackPanel>

        <!-- ===== danh sách tên, tick nhiều cùng lúc ===== -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <ListBox x:Name="NameList" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" Content="{Binding Name}"
                                  Margin="2,2" ToolTip="{Binding Name}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ===== tên tự gõ ===== -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Hoặc gõ / dán tên, mỗi dòng một tên (dùng được cả khi chưa kết nối):"
                       Foreground="#605E5C" />
            <TextBox x:Name="ManualBox" Height="78" Margin="0,4,0,0" AcceptsReturn="True" FontFamily="Consolas"
                     Padding="6,4" VerticalScrollBarVisibility="Auto" TextChanged="ManualBox_TextChanged" />
        </StackPanel>

        <!-- ===== footer ===== -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="CountText" HorizontalAlignment="Left" VerticalAlignment="Center"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddMoreButton" Content="Thêm &amp; chọn tiếp" Style="{StaticResource Flat}"
                        MinWidth="130" Click="AddMore_Click"
                        ToolTip="Đẩy các tên đang chọn vào danh sách rồi ở lại đây để chọn tiếp loại khác." />
                <Button x:Name="AddButton" Content="Thêm vào danh sách" Style="{StaticResource Primary}"
                        MinWidth="150" IsDefault="True" Click="AddClose_Click" />
                <Button Content="Đóng" Style="{StaticResource Flat}" MinWidth="80" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
