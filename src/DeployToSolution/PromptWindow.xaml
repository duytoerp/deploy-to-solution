<Window x:Class="DeployToSolution.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đặt tên" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Chrome}" FontSize="13">
    <StackPanel Margin="14">
        <TextBlock x:Name="Label" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="Input" Padding="6,4" />
        <TextBlock x:Name="Hint" Foreground="#605E5C" TextWrapping="Wrap" Margin="0,6,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Style="{StaticResource Primary}" MinWidth="90" IsDefault="True" Click="Ok_Click" />
            <Button Content="Hủy" Style="{StaticResource Flat}" MinWidth="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
