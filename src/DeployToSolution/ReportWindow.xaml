<Window x:Class="DeployToSolution.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Báo cáo deploy" Height="640" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Chrome}" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="#605E5C" TextWrapping="Wrap"
                   Text="Nội dung dưới đây gom theo loại component, plugin step trùng tiền tố được rút thành prefix.* — dán thẳng vào ticket deploy." />

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <TextBox x:Name="ReportText" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                     BorderThickness="0" Padding="10" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     AcceptsReturn="True" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Copy toàn bộ" Style="{StaticResource Primary}" MinWidth="120" Click="Copy_Click" />
            <Button Content="Lưu Excel..." Style="{StaticResource Flat}" MinWidth="110" Click="SaveExcel_Click" />
            <Button Content="Lưu text..." Style="{StaticResource Flat}" MinWidth="100" Click="Save_Click" />
            <Button Content="Đóng" Style="{StaticResource Flat}" MinWidth="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
